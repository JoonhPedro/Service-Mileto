generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url = env("DATABASE_URL")
}

model Transaction {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  name String
  categoria String
  preco String
  status String
  metodo String
  file String
  created_at DateTime ? @default(now()) 
  updated_at DateTime ? @default(now()) 
}

model Termo {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  contract String
  observation String
  created_at DateTime ? @default(now()) 
  updated_at DateTime ? @default(now()) 
}